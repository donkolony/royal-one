# Royal Square Financial — Environment Variables
# Copy to .env.local and fill in your values. Never commit .env.local

# Backend API base URL. Leave empty or set to "mock" to use fixture data while backend is being built.
VITE_API_URL=http://localhost:8000

# Supabase project — public/anon key only (safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

