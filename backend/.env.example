# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Every variable is read in backend/app/core/config.py (the only place env vars are read).

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Supabase (Project settings in the Supabase dashboard) ----
SUPABASE_URL=
# Server-side key. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=   # the SECRET key (sb_secret_...), NOT the publishable key; the app refuses a publishable one
# Postgres connection string. Confirm in the Supabase dashboard whether to use the direct or the pooled
# host for your deployment target (the direct host may be IPv6 only). Behind a transaction-mode pooler this
# app already disables prepared statements.
DATABASE_URL=   # must start with postgresql://  (an https://...supabase.co URL is the REST API, not the database)

# ---- How access tokens are verified ----
# supabase    : supabase-py get_claims (recommended; asymmetric keys are verified locally, HS256 via Supabase Auth)
# local_hs256 : verify HS256 tokens locally with SUPABASE_JWT_SECRET (offline development and tests)
AUTH_MODE=supabase
SUPABASE_JWT_SECRET=

# ---- File storage ----
# supabase : private buckets (created by the migration, or create them in the dashboard)
# memory   : in-process, for offline development only (files vanish on restart)
STORAGE_BACKEND=supabase
ATTACHMENTS_BUCKET=attachments
RAG_DOCS_BUCKET=rag-docs

# ---- LLM (used by the assistant and email drafts) ----
# groq | gemini | none. Model names are NOT defaulted: read each provider's current documentation and set them here.
LLM_PROVIDER=none
LLM_FALLBACK_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=20

# ---- Email ----
# Only "mock" exists. Live Gmail is not built.
EMAIL_PROVIDER=mock

# ---- HTTP ----
# Comma-separated frontend origins, exact match (scheme, host and port).
ALLOWED_ORIGINS=http://localhost:5173

# ---- Limits ----
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENTS_PER_CLAIM=40
MAX_ATTACHMENTS_PER_REQUEST=5
SIGNED_URL_TTL_SECONDS=600
ASSISTANT_RATE_LIMIT_PER_MIN=10
DB_POOL_MIN=1
DB_POOL_MAX=8

# ---- Seeding only (scripts/seed.py --auth) ----
# Password given to the demo Supabase Auth users. Choose your own; it is never printed or committed.
SEED_DEMO_PASSWORD=
